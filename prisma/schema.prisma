generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  LEARNER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
}

enum LessonType {
  VIDEO
  READING
  QUIZ
}

enum AssetKind {
  VIDEO
  FILE
  IMAGE
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model User {
  id                 String            @id @default(cuid())
  name               String?
  email              String            @unique
  passwordHash       String
  role               UserRole          @default(LEARNER)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  websiteContent     WebsiteContent[]  @relation("ContentEditor")
  createdCourses     Course[]          @relation("CourseInstructor")
  reviewedCourses    Course[]          @relation("CourseReviewer")
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  paymentsReviewed   Payment[]         @relation("PaymentReviewer")
  blogPosts          BlogPost[]        @relation("BlogAuthor")
  ebooks             Ebook[]           @relation("EbookAuthor")
  ebookOrders        EbookOrder[]
  ebookOrdersReviewed EbookOrder[]     @relation("EbookOrderReviewer")
  hostedLiveSessions LiveSession[]     @relation("LiveHost")
  liveSignalsSent    LiveSignal[]      @relation("LiveSignalSender")
}

model WebsiteContent {
  id          String        @id @default(cuid())
  key         String
  locale      String        @default("en")
  title       String
  markdown    String
  status      ContentStatus @default(DRAFT)
  updatedAt   DateTime      @updatedAt
  updatedById String?
  updatedBy   User?         @relation("ContentEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([key, locale])
}

model Course {
  id                  String         @id @default(cuid())
  slug                String         @unique
  title               String
  titleNe             String?
  description         String
  descriptionNe       String?
  category            String
  level               String
  image               String?
  coverImage          String?
  instructorName      String
  priceNpr            Int            @default(0)
  paymentQrPath       String?
  paymentInstructions String?
  status              CourseStatus   @default(DRAFT)
  featured            Boolean        @default(false)
  durationText        String?
  rating              Float          @default(0)
  studentsCount       Int            @default(0)
  publishedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  instructorId        String
  reviewedById        String?
  reviewNotes         String?
  instructor          User           @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  reviewedBy          User?          @relation("CourseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  modules             CourseModule[]
  enrollments         Enrollment[]
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  titleNe     String?
  description String?
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId, sortOrder])
}

model Lesson {
  id           String           @id @default(cuid())
  moduleId      String
  slug         String
  title        String
  titleNe      String?
  summary      String?
  content      String?
  type         LessonType       @default(READING)
  sortOrder    Int
  durationMins Int              @default(10)
  isPreview    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  module       CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assets       LessonAsset[]
  progress     LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
}

model LessonAsset {
  id          String   @id @default(cuid())
  lessonId    String
  storagePath String
  mimeType    String
  kind        AssetKind
  label       String?
  createdAt   DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id            String         @id @default(cuid())
  userId        String
  courseId      String
  paymentStatus PaymentStatus  @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment       Payment?

  @@unique([userId, courseId])
}

model Payment {
  id            String        @id @default(cuid())
  enrollmentId  String        @unique
  amount        Int
  currency      String        @default("NPR")
  qrReference   String?
  receiptPath   String?
  notes         String?
  status        PaymentStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  titleNe     String?
  excerpt     String
  content     String
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  authorId    String
  author      User          @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
}

model Ebook {
  id                  String        @id @default(cuid())
  slug                String        @unique
  title               String
  titleNe             String?
  description         String
  content             String        @default("")
  coverImage          String?
  filePath            String?
  priceNpr            Int           @default(0)
  isFree              Boolean       @default(true)
  paymentQrPath       String?
  paymentInstructions String?
  status              ContentStatus @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  authorId            String
  author              User          @relation("EbookAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  orders              EbookOrder[]

  @@index([status, publishedAt])
}

model EbookOrder {
  id            String        @id @default(cuid())
  userId        String
  ebookId       String
  amount        Int           @default(0)
  currency      String        @default("NPR")
  paymentStatus PaymentStatus @default(PENDING)
  receiptPath   String?
  notes         String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook         Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation("EbookOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, ebookId])
}

model LiveSession {
  id          String            @id @default(cuid())
  title       String
  description String?
  scheduledAt DateTime
  status      LiveSessionStatus @default(SCHEDULED)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  hostId      String
  host        User              @relation("LiveHost", fields: [hostId], references: [id], onDelete: Restrict)
  signals     LiveSignal[]

  @@index([status, scheduledAt])
}

model LiveSignal {
  id         String      @id @default(cuid())
  sessionId  String
  fromUserId String
  toUserId   String?
  type       String
  payload    String
  consumed   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromUser   User        @relation("LiveSignalSender", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([sessionId, toUserId, consumed, createdAt])
  @@index([sessionId, type, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
